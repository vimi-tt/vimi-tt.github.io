---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title = "José Vitor Diniz Miranda | Engenheiro de Software",
  description = "Portfólio de José Vitor Diniz Miranda (vimi-tt) — Software nativo Android, sistemas em Rust, Haskell e notas técnicas."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>{title}</title>

  <!-- Fontes: Archivo (Display), Manrope (Corpo), JetBrains Mono (Metadados e Código) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-[#F4F4F0] text-[#111214] antialiased relative min-h-screen overflow-x-hidden font-sans">

  <!-- Barra de progresso de leitura -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-[2px] bg-[#2B35AF] z-50 w-0 pointer-events-none transition-all duration-75" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col min-h-screen">
    <slot />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const initScrollTelemetry = () => {
      const scrollProgressBar = document.getElementById('scroll-progress');
      if (!scrollProgressBar) return;

      window.addEventListener('scroll', () => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? (window.scrollY / maxScroll) * 100 : 0;
        scrollProgressBar.style.width = `${progress}%`;
      }, { passive: true });
    };

    const initArchitecturalMotion = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const plates = document.querySelectorAll<HTMLElement>('[data-reveal-plate]');
      plates.forEach((plate) => {
        gsap.from(plate, {
          y: 18,
          duration: 0.7,
          ease: 'expo.out',
          clearProps: 'transform',
          scrollTrigger: {
            trigger: plate,
            start: 'top 88%',
            once: true
          }
        });
      });
    };

    document.addEventListener('DOMContentLoaded', () => {
      initScrollTelemetry();
      initArchitecturalMotion();
    });
  </script>
</body>
</html>

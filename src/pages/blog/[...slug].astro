---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    posts = await getCollection('blog');
  } catch (e) {
    posts = [];
  }

  if (!posts || posts.length === 0) {
    const globPosts = import.meta.glob('../../content/blog/*.{md,mdx}', { eager: true });
    return Object.entries(globPosts).map(([path, mod]: [string, any]) => {
      const slug = path.split('/').pop()?.replace(/\.(md|mdx)$/, '').toLowerCase();
      const frontmatter = mod.frontmatter || {};
      return {
        params: { slug },
        props: {
          post: {
            id: slug,
            slug,
            data: {
              title: frontmatter.title || 'Sem Título',
              description: frontmatter.description || '',
              pubDate: frontmatter.pubDate ? new Date(frontmatter.pubDate) : new Date(),
              tags: frontmatter.tags || [],
              draft: frontmatter.draft || false
            },
            ContentComponent: mod.Content || mod.default
          }
        }
      };
    });
  }

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;

let RenderedContent = (post as any).ContentComponent;
if (!RenderedContent) {
  const rendered = await render(post);
  RenderedContent = rendered.Content;
}

const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric'
  });
---

<Layout title={`${post.data.title} | Vitor Miranda`} description={post.data.description}>
  <Header />

  <main class="flex-grow">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-20">

      <div class="mb-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-xs font-semibold text-[#4B4F58] hover:text-[#2B35AF] transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" stroke-linecap="square" />
          </svg>
          <span>Voltar para Notas Técnicas</span>
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#6C707A] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>&bull;</span>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="px-2 py-0.5 text-[11px] bg-[#ECECE6] border border-[#D4D5CF] text-[#4B4F58]">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <h1 class="font-display font-black text-3xl sm:text-5xl text-[#111214] tracking-[-0.03em] mb-6">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-base sm:text-lg text-[#4B4F58] leading-relaxed border-l border-[#2B35AF] pl-4 py-1 mb-10">
          {post.data.description}
        </p>
      )}

      <hr class="border-[#D4D5CF] mb-12" />

      <div class="markdown-content">
        <RenderedContent />
      </div>

      <div class="mt-16 pt-8 border-t border-[#D4D5CF] flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href="/blog"
          class="text-xs font-semibold text-[#4B4F58] hover:text-[#2B35AF] transition-colors inline-flex items-center gap-2"
        >
          <span>&larr; Todos os artigos</span>
        </a>

        <a
          href="https://github.com/vimi-tt"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-[#111214] hover:text-[#2B35AF] transition-colors inline-flex items-center gap-1.5"
        >
          <span>Vitor Miranda no GitHub</span>
          <span>&nearr;</span>
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

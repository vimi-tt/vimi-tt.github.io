---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = await getCollection('blog', ({ data }) => !data.draft);
} catch (e) {
  posts = [];
}

if (!posts || posts.length === 0) {
  const globPosts = import.meta.glob('../../content/blog/*.{md,mdx}', { eager: true });
  posts = Object.entries(globPosts)
    .map(([path, mod]: [string, any]) => {
      const slug = path.split('/').pop()?.replace(/\.(md|mdx)$/, '').toLowerCase();
      const frontmatter = mod.frontmatter || {};
      return {
        id: slug,
        slug: slug,
        data: {
          title: frontmatter.title || 'Sem Título',
          description: frontmatter.description || '',
          pubDate: frontmatter.pubDate ? new Date(frontmatter.pubDate) : new Date(),
          tags: frontmatter.tags || [],
          draft: frontmatter.draft || false
        },
        Content: mod.default
      };
    })
    .filter((p) => !p.data.draft);
}

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
    .toUpperCase();
---

<Layout title="Notas Técnicas | José Vitor Diniz Miranda" description="Artigos e notas de engenharia por Vitor Miranda.">
  <Header />

  <main class="flex-grow">
    <section class="border-b border-[#D4D5CF]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-x border-[#D4D5CF] p-6 sm:p-10 lg:px-14 lg:py-14">
          <h1 class="font-display font-black text-4xl sm:text-6xl text-[#111214] tracking-[-0.03em] uppercase">
            Notas Técnicas
          </h1>
          <p class="mt-3 text-base text-[#4B4F58] max-w-2xl">
            Anotações sobre sistemas operacionais, arquitetura de software e computação.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-x border-[#D4D5CF]">
        {posts.length === 0 ? (
          <div class="p-10 text-center text-[#4B4F58]">
            Nenhuma publicação encontrada no momento.
          </div>
        ) : (
          <div class="divide-y divide-[#D4D5CF]">
            {posts.map((post) => (
              <article class="p-6 sm:p-10 lg:px-14 bg-[#F4F4F0] hover:bg-[#ECECE6]/60 transition-colors group">
                <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[#6C707A] mb-4">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>

                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag: string) => (
                      <span class="px-2 py-0.5 text-[11px] bg-[#ECECE6] border border-[#D4D5CF] text-[#4B4F58]">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <h2 class="font-display font-bold text-2xl sm:text-3xl text-[#111214] group-hover:text-[#2B35AF] transition-colors mb-3">
                  <a href={`/blog/${post.id || post.slug}`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm sm:text-base text-[#4B4F58] leading-relaxed max-w-3xl mb-6">
                  {post.data.description}
                </p>

                <a
                  href={`/blog/${post.id || post.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#111214] group-hover:text-[#2B35AF] transition-colors"
                >
                  <span>Ler artigo</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="square" />
                  </svg>
                </a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

---
// Skills - Matriz técnica de linguagens, paradigmas e ambiente
const languages = [
  { name: 'Kotlin', detail: 'Android · Jetpack Compose · Coroutines' },
  { name: 'Rust', detail: 'Sistemas · CLI · Memory Safety' },
  { name: 'Haskell', detail: 'Programação Funcional · Teoria' },
  { name: 'C / C#', detail: 'POSIX · Baixo Nível · Estruturas' },
  { name: 'Java & Python', detail: 'POO · Análise de Dados · Scripting' }
];

const toolchain = [
  { label: 'Sistema Operacional', value: 'Linux (x86_64) · Fluxo Unix / Bash' },
  { label: 'Mobile & Build', value: 'Android SDK · Gradle · Jetpack Compose' },
  { label: 'Editores', value: 'Zed · Neovim · Android Studio' },
  { label: 'Versionamento & CI', value: 'Git · GitHub Actions' },
  { label: 'Web & Dados', value: 'Astro · TypeScript · Pandas · Matplotlib' }
];
---

<section id="habilidades" class="relative w-full border-b border-[#D4D5CF]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-x border-[#D4D5CF]">

      <div class="p-6 sm:p-10 lg:px-14 lg:py-12 border-b border-[#D4D5CF] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <h2 class="font-display font-black text-3xl sm:text-5xl text-[#111214] tracking-[-0.03em] uppercase">
          Competências
        </h2>
        <p class="font-mono text-xs text-[#4B4F58] uppercase tracking-wider">
          Linguagens, compiladores &amp; ambiente
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[#D4D5CF]">

        <!-- Coluna 1: Linguagens -->
        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-14">
          <h3 class="font-display font-bold text-xl text-[#111214] mb-6">
            Linguagens e Paradigmas
          </h3>

          <div class="divide-y divide-[#D4D5CF] border-y border-[#D4D5CF]">
            {languages.map((lang) => (
              <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="font-display font-bold text-base text-[#111214]">
                  {lang.name}
                </span>
                <span class="font-mono text-xs text-[#4B4F58]">
                  {lang.detail}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Coluna 2: Ambiente & Ferramentas -->
        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-14 bg-[#ECECE6]/35">
          <h3 class="font-display font-bold text-xl text-[#111214] mb-6">
            Ambiente e Ferramentas
          </h3>

          <dl class="divide-y divide-[#D4D5CF] border-y border-[#D4D5CF]">
            {toolchain.map((item) => (
              <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <dt class="font-mono text-xs uppercase tracking-wider text-[#6C707A]">
                  {item.label}
                </dt>
                <dd class="text-sm font-medium text-[#111214] sm:text-right">
                  {item.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>

      </div>

    </div>
  </div>
</section>

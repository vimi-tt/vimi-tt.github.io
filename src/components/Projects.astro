---
// Projects Component - Edge-to-Edge Full Width Saturated Cards
const githubUsername = 'vimi-tt';
const visibleReposNames = ['Flicker', 'Automato-Playground'];

// Paleta de Cores Sólidas e Contrastantes para os Cartões
const cardColors = [
  '#6B44FF', // Roxo Neon
  '#00B4D8', // Azul Turquesa
  '#E63946', // Vermelho Vibrante
  '#2A6F97', // Azul Marinho Claro
  '#059669', // Verde Esmeralda
  '#7209B7'  // Violeta Intenso
];

// Dados de fallback para repositórios do GitHub
const fallbackRepos = [
  {
    name: 'Flicker',
    description: 'Utilitário de linha de comando e processamento de alta performance para ambientes Linux e criação segura de mídias bootáveis.',
    language: 'Rust',
    html_url: 'https://github.com/vimi-tt/Flicker',
    stargazers_count: 0,
    forks_count: 0,
    archived: false,
    button_text: 'VER_REPOSITÓRIO'
  },
  {
    name: 'Automato-Playground',
    description: 'Ambiente interativo e biblioteca para simulação, minimização e equivalência de Autômatos Finitos (DFA/NFA) e Teoria da Computação.',
    language: 'Haskell',
    html_url: 'https://github.com/vimi-tt/Automato-Playground',
    stargazers_count: 0,
    forks_count: 0,
    archived: false,
    button_text: 'VER_REPOSITÓRIO'
  }
];

// Projetos externos adicionais (não restritos à API do GitHub)
const externalProjects = [
  {
    name: 'Null:Gemini',
    description: 'Boas vindas as Terras Semfim! Embarque em uma aventura com Kuati no mundo do espelho em busca de respostas para o seu aprisionamento nessa dimensão caótica de Lugarnenhum.',
    language: 'Unity',
    html_url: 'https://dobled08.itch.io/nullgemini',
    button_text: 'JOGAR_NO_ITCH.IO',
    archived: false,
    badge: 'GAME DEV'
  },
  {
    name: 'Guia de PPC - UFCG',
    description: 'Guia de PPC para o curso de Ciência da Computação - UFCG. Consulte ementas, pré-requisitos, créditos e bibliografias atualizadas.',
    language: 'Web / UFCG',
    html_url: 'https://guiappc.vercel.app/',
    button_text: 'ACESSAR_GUIA',
    archived: false,
    badge: 'WEB APP'
  }
];

let repos: any[] = [];
try {
  const response = await fetch(`https://api.github.com/users/${githubUsername}/repos?sort=updated&per_page=50`, {
    headers: { 'User-Agent': 'vimi-portfolio-build' }
  });
  if (response.ok) {
    repos = await response.json();
  }
} catch (e) {
  console.error("Error fetching repos:", e);
}

const validRepos = Array.isArray(repos) ? repos.filter((repo: any) => !repo.fork && !repo.message) : [];
let githubRepos: any[] = [];

if (validRepos.length > 0) {
  githubRepos = visibleReposNames
    .map((name) => {
      const fromApi = validRepos.find((repo: any) => repo.name.toLowerCase() === name.toLowerCase());
      if (fromApi) {
        return {
          ...fromApi,
          button_text: 'VER_REPOSITÓRIO'
        };
      }
      return fallbackRepos.find((repo) => repo.name.toLowerCase() === name.toLowerCase());
    })
    .filter(Boolean);
} else {
  githubRepos = fallbackRepos;
}

const allProjects = [...githubRepos, ...externalProjects];
---

<section id="projetos" class="relative w-full border-b border-white/20">
  
  <!-- Cabeçalho da Seção de Projetos (Sem subtítulos) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="flex items-center gap-3 text-xs font-mono text-[#BDB2FF] uppercase tracking-widest mb-2">
      <span class="w-2 h-2 rounded-full bg-[#BDB2FF]"></span>
      <span>// IT_WORKS_ON_MY_MACHINE</span>
    </div>
    <h2 class="font-display font-black text-4xl sm:text-6xl md:text-7xl text-[#F3F3F3] tracking-tight uppercase">
      PROJETOS
    </h2>
  </div>

  <!-- Container de Projetos Edge-to-Edge (width: 100%; flex-direction: column; padding-inline: 0px) -->
  <div class="flex flex-col w-full">
    {allProjects.map((project: any, index: number) => {
      const bgColor = cardColors[index % cardColors.length];
      const isArchived = Boolean(project.archived);

      return (
        <article 
          style={`background-color: ${bgColor};`}
          class="w-full relative overflow-hidden text-white transition-transform duration-200 border-t border-black/30"
        >
          <div class="max-w-7xl mx-auto px-6 py-12 sm:px-12 sm:py-16 md:px-16 md:py-20 flex flex-col justify-between min-h-[360px] sm:min-h-[420px] relative z-10">
            
            <!-- Topo do Cartão: Tag da Linguagem no canto superior esquerdo -->
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="font-mono text-xs sm:text-sm font-bold tracking-wider uppercase px-3 py-1 bg-black text-white border border-white/20">
                {project.language || 'SYS / ALGO'}
              </span>

              <span class="font-mono text-xs text-white/80 font-semibold tracking-widest uppercase">
                #0{index + 1}
              </span>
            </div>

            <!-- Meio: Título e Descrição com Tipografia de Peso Médio alinhados à esquerda -->
            <div class="max-w-3xl my-auto">
              <h3 class="font-display font-bold text-3xl sm:text-5xl md:text-6xl tracking-tight text-white mb-4">
                <a 
                  href={project.html_url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="hover:underline underline-offset-8 transition-all"
                >
                  {project.name}
                </a>
              </h3>

              <p class="font-mono text-sm sm:text-base md:text-lg text-white/90 leading-relaxed font-normal">
                {project.description || 'Projeto focado em engenharia de sistemas, performance e desenvolvimento.'}
              </p>
            </div>

            <!-- Rodapé do Cartão: Métricas com Caixas Translúcidas -->
            <div class="mt-8 pt-6 border-t border-white/20 flex flex-wrap items-center justify-between gap-4">
              
              <!-- Caixas Translúcidas para Métricas -->
              <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                {project.stargazers_count !== undefined && (
                  <div class="px-3 py-1.5 rounded-none font-mono text-xs sm:text-sm tracking-wider flex items-center gap-1.5 bg-white/10 backdrop-blur-md border border-white/20">
                    <span class="material-symbols-rounded text-sm">star</span>
                    <span>{project.stargazers_count}</span>
                  </div>
                )}

                {project.badge && (
                  <div class="px-3 py-1.5 rounded-none font-mono text-xs sm:text-sm tracking-wider bg-white/10 backdrop-blur-md border border-white/20">
                    <span class="text-white font-bold">{project.badge}</span>
                  </div>
                )}

                <!-- STATUS: DISABLED se arquivado, STATUS: ACTIVE se ativo -->
                <div class="px-3 py-1.5 rounded-none font-mono text-xs sm:text-sm font-bold tracking-wider bg-white/10 backdrop-blur-md border border-white/20">
                  {isArchived ? (
                    <span class="text-white/70">STATUS: DISABLED</span>
                  ) : (
                    <span class="text-white">STATUS: ACTIVE</span>
                  )}
                </div>
              </div>

              <!-- Link direto de Ação -->
              <a 
                href={project.html_url} 
                target="_blank" 
                rel="noopener noreferrer" 
                data-magnetic
                class="px-4 py-2 bg-black hover:bg-black/80 text-white font-mono text-xs sm:text-sm font-bold tracking-wider uppercase border border-white/20 transition-colors inline-flex items-center gap-1.5"
              >
                <span>{project.button_text || 'ACESSAR_PROJETO'}</span>
                <span>&nearr;</span>
              </a>

            </div>

          </div>

          <!-- Micro-interação Visual no canto inferior direito -->
          <div 
            class="absolute right-4 sm:right-10 bottom-0 pointer-events-none select-none opacity-20 hover:opacity-30 transition-opacity z-0"
            aria-hidden="true"
          >
            {isArchived ? (
              <svg width="180" height="180" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 sm:w-44 h-auto">
                <path d="M25 90V40C25 25 35 15 50 15C65 15 75 25 75 40V90H25Z" stroke="white" stroke-width="4" fill="currentColor"/>
                <text x="50" y="50" text-anchor="middle" font-family="monospace" font-size="14" font-weight="bold" fill="black">RIP</text>
                <text x="50" y="66" text-anchor="middle" font-family="monospace" font-size="8" font-weight="bold" fill="black">ARCHIVED</text>
              </svg>
            ) : (
              <svg width="180" height="180" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 sm:w-44 h-auto">
                <circle cx="50" cy="50" r="40" stroke="white" stroke-width="4" stroke-dasharray="6 6"/>
                <polygon points="50,20 60,40 80,45 65,60 70,80 50,70 30,80 35,60 20,45 40,40" stroke="white" stroke-width="3" fill="none"/>
                <text x="50" y="54" text-anchor="middle" font-family="monospace" font-size="9" font-weight="bold" fill="white">ACTIVE</text>
              </svg>
            )}
          </div>

        </article>
      );
    })}
  </div>

  <!-- Botão para Explorar Todos no GitHub -->
  <div class="py-12 bg-[#0F0F0F] text-center">
    <a 
      href={`https://github.com/${githubUsername}?tab=repositories`} 
      target="_blank" 
      rel="noopener noreferrer"
      data-magnetic
      class="inline-flex items-center gap-3 px-8 py-4 bg-transparent border-2 border-white/30 hover:border-[#BDB2FF] hover:text-[#BDB2FF] text-[#F3F3F3] font-mono text-xs sm:text-sm font-bold tracking-widest uppercase transition-colors"
    >
      <span>EXPLORAR_TODOS_OS_REPOSITÓRIOS_NO_GITHUB</span>
      <span>&rarr;</span>
    </a>
  </div>

</section>

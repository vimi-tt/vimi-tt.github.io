---
// Projects - Vitrine em dois níveis: Placas de Espécime (Overview & Verso) + Índice de Sistemas e Web
const githubUsername = 'vimi-tt';

interface FeaturedSpec {
  repoName: string;
  id: string;
  displayName: string;
  subtitle: string;
  stackTag: string;
  platform: string;
  releaseTag: string;
  description: string;
  highlights: string[];
  fallbackUrl: string;
  fallbackLanguage: string;
  variant: 'overview' | 'verso' | 'flicker';
}

const featuredSpecs: FeaturedSpec[] = [
  {
    repoName: 'Overview',
    id: 'projeto-overview',
    displayName: 'Overview',
    subtitle: 'Launcher Android inspirado no GNOME 51 / libadwaita',
    stackTag: 'Kotlin · Compose',
    platform: 'Android 12+ (API 31–35)',
    releaseTag: 'v1.1 · GPL-3.0',
    description:
      'Construído do zero em Kotlin e Jetpack Compose, trazendo a organização espacial do GNOME Shell e a clareza do libadwaita para dispositivos móveis com foco em gestos fluidos.',
    highlights: [
      'Grade personalizável de 3×3 a 6×6 com suporte a widgets (AppWidgetHost)',
      '6 estilos de relógio ao vivo, incluindo mostrador analógico Adwaita em Canvas',
      'Contraste adaptativo automático via WallpaperManager.OnColorsChangedListener',
      'Dash fixo, pastas e visão geral paginada com resposta a 60/120 Hz'
    ],
    fallbackUrl: 'https://github.com/vimi-tt/Overview',
    fallbackLanguage: 'Kotlin',
    variant: 'overview'
  },
  {
    repoName: 'verso',
    id: 'projeto-verso',
    displayName: 'Verso',
    subtitle: 'Player de música Android com streaming, offline e letras sincronizadas',
    stackTag: 'Kotlin · Compose',
    platform: 'Android 10+ (API 29+)',
    releaseTag: 'v1.0-beta1',
    description:
      'Player de música em Kotlin e Compose que combina streaming do YouTube Music, fila paralela de downloads offline em chunks, letras palavra por palavra e integração com Last.fm.',
    highlights: [
      'Downloads paralelos (4 faixas simultâneas) via HTTP Range chunking e I/O com buffer',
      'Streaming YouTube Music com Activity Mix e sincronização opcional de histórico',
      'Letras sincronizadas por sílaba/palavra e reprodução offline de coleções',
      'Scrobbling nativo no Last.fm e cartões compartilháveis de Recap'
    ],
    fallbackUrl: 'https://github.com/vimi-tt/verso',
    fallbackLanguage: 'Kotlin',
    variant: 'verso'
  },
  {
    repoName: 'Flicker',
    id: 'projeto-flicker',
    displayName: 'Flicker',
    subtitle: 'Criador de mídias USB bootáveis para Linux em Rust',
    stackTag: 'Rust · Sistemas',
    platform: 'Linux (GUI + CLI)',
    releaseTag: 'Rust 1.70+ · MIT',
    description:
      'Alternativa moderna ao Rufus para Linux escrita em Rust em binário único sem dependências externas — combinando interface gráfica Material Design 3 (com elevação via pkexec) e modo CLI completo.',
    highlights: [
      'Escrita otimizada em blocos de 4 MB com barra de progresso, ETA e taxa em tempo real',
      'Detecção inteligente de dispositivos USB e desmontagem automática antes da gravação',
      'Verificação opcional byte a byte após a escrita para garantir integridade da ISO',
      'Múltiplas validações de segurança contra perda acidental de dados em discos do sistema'
    ],
    fallbackUrl: 'https://github.com/vimi-tt/Flicker',
    fallbackLanguage: 'Rust',
    variant: 'flicker'
  }
];

const archiveRepoNames = ['Automato-Playground'];

const archiveFallbacks: Record<string, any> = {
  'Automato-Playground': {
    name: 'Automato-Playground',
    description:
      'Simulador interativo e biblioteca em Haskell para construção, minimização e equivalência de Autômatos Finitos (DFA/NFA).',
    language: 'Haskell',
    html_url: 'https://github.com/vimi-tt/Automato-Playground',
    stargazers_count: 0,
    archived: false,
    category: 'Teoria da Computação',
    actionLabel: 'Ver repositório'
  }
};

const externalArchive = [
  {
    name: 'Guia de PPC — UFCG',
    description:
      'Aplicação web para consulta do Projeto Pedagógico do Curso de Ciência da Computação da UFCG: ementas, pré-requisitos, créditos e bibliografias.',
    language: 'Web App',
    html_url: 'https://guiappc.vercel.app/',
    category: 'Acadêmico / Web',
    actionLabel: 'Acessar aplicação'
  }
];

let repos: any[] = [];
try {
  const response = await fetch(
    `https://api.github.com/users/${githubUsername}/repos?sort=updated&per_page=50`,
    { headers: { 'User-Agent': 'vimi-portfolio-build' } }
  );
  if (response.ok) {
    repos = await response.json();
  }
} catch (e) {
  console.error('Error fetching GitHub repos:', e);
}

const validRepos = Array.isArray(repos)
  ? repos.filter((repo: any) => !repo.fork && !repo.message)
  : [];

const findRepo = (name: string) =>
  validRepos.find((r: any) => r.name?.toLowerCase() === name.toLowerCase());

const featuredProjects = featuredSpecs.map((spec) => {
  const api = findRepo(spec.repoName);
  return {
    ...spec,
    html_url: api?.html_url || spec.fallbackUrl,
    language: api?.language || spec.fallbackLanguage,
    stargazers_count: api?.stargazers_count ?? 0,
    updated_at: api?.updated_at || null
  };
});

const archiveRepos = archiveRepoNames.map((name) => {
  const api = findRepo(name);
  const fb = archiveFallbacks[name];
  return {
    name: api?.name || fb.name,
    description: fb.description,
    language: api?.language || fb.language,
    html_url: api?.html_url || fb.html_url,
    stargazers_count: api?.stargazers_count ?? fb.stargazers_count,
    category: fb.category,
    actionLabel: fb.actionLabel
  };
});

const archiveProjects = [...archiveRepos, ...externalArchive];
---

<section id="projetos" class="relative w-full border-b border-[#D4D5CF]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-x border-[#D4D5CF]">

      <!-- Cabeçalho da Seção -->
      <div class="p-6 sm:p-10 lg:px-14 lg:py-12 border-b border-[#D4D5CF] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <h2 class="font-display font-black text-3xl sm:text-5xl text-[#111214] tracking-[-0.03em] uppercase">
          Projetos Selecionados
        </h2>
        <p class="font-mono text-xs text-[#4B4F58] uppercase tracking-wider">
          Recentes do GitHub &amp; sistemas autorais
        </p>
      </div>

      <!-- Nível 1: Placas de Espécime em Obsidiana (Overview & Verso) -->
      <div class="divide-y divide-[#2A2C34]">
        {featuredProjects.map((project, index) => (
          <article
            id={project.id}
            data-reveal-plate
            class="bg-[#131418] text-[#F4F4F0] grid grid-cols-1 lg:grid-cols-12"
          >
            <!-- Conteúdo Técnico (Esquerda) -->
            <div class="lg:col-span-7 p-6 sm:p-10 lg:p-14 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-[#2A2C34]">
              <div>
                <div class="flex flex-wrap items-center gap-2.5 mb-6 font-mono text-xs">
                  <span class="px-2.5 py-1 bg-[#2B35AF] text-[#F4F4F0] font-semibold tracking-wider uppercase">
                    {project.stackTag}
                  </span>
                  <span class="px-2.5 py-1 border border-[#2A2C34] text-[#A4A8B3]">
                    {project.platform}
                  </span>
                  <span class="px-2.5 py-1 border border-[#2A2C34] text-[#A4A8B3]">
                    {project.releaseTag}
                  </span>
                </div>

                <h3 class="font-display font-black text-3xl sm:text-5xl tracking-[-0.03em] text-[#F4F4F0]">
                  <a
                    href={project.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[#A8B1FF] transition-colors"
                  >
                    {project.displayName}
                  </a>
                </h3>

                <p class="mt-2 text-base sm:text-lg font-medium text-[#D1D4DC]">
                  {project.subtitle}
                </p>

                <p class="mt-5 text-sm sm:text-base text-[#A4A8B3] leading-relaxed max-w-2xl">
                  {project.description}
                </p>

                <ul class="mt-7 space-y-2.5 border-t border-[#2A2C34] pt-6 text-sm text-[#D1D4DC]">
                  {project.highlights.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="w-1.5 h-1.5 bg-[#2B35AF] mt-2 shrink-0" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 pt-6 border-t border-[#2A2C34] flex flex-wrap items-center justify-between gap-4">
                <span class="font-mono text-xs text-[#A4A8B3]">
                  github.com/vimi-tt/{project.repoName}
                </span>

                <a
                  href={project.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-5 py-2.5 bg-[#F4F4F0] hover:bg-[#2B35AF] text-[#111214] hover:text-[#F4F4F0] font-semibold text-xs sm:text-sm tracking-tight transition-colors inline-flex items-center gap-2"
                >
                  <span>Ver código no GitHub</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M4.5 11.5L11.5 4.5M6 4.5h5.5V10" stroke-linecap="square" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Espécime Arquitetônico Visual (Direita) -->
            <div class="lg:col-span-5 p-8 sm:p-12 flex items-center justify-center bg-[#0D0E12] relative overflow-hidden">
              {project.variant === 'overview' ? (
                <svg
                  viewBox="0 0 280 380"
                  class="w-full max-w-[260px] h-auto text-[#F4F4F0]"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label="Diagrama esquemático da interface do Overview Launcher"
                >
                  <!-- Moldura do dispositivo -->
                  <rect x="20" y="10" width="240" height="360" rx="22" stroke="#2A2C34" stroke-width="1.5" fill="#131418" />
                  <!-- Barra superior GNOME / Cápsula -->
                  <rect x="44" y="28" width="64" height="10" rx="5" fill="#2A2C34" />
                  <circle cx="222" cy="33" r="4" fill="#2B35AF" />
                  <!-- Mostrador Analógico Adwaita -->
                  <circle cx="140" cy="108" r="42" stroke="#F4F4F0" stroke-width="1.5" />
                  <circle cx="140" cy="108" r="2.5" fill="#2B35AF" />
                  <line x1="140" y1="108" x2="140" y2="80" stroke="#F4F4F0" stroke-width="2" stroke-linecap="round" />
                  <line x1="140" y1="108" x2="164" y2="118" stroke="#A4A8B3" stroke-width="1.5" stroke-linecap="round" />
                  <!-- Barra de busca Overview -->
                  <rect x="44" y="172" width="192" height="26" rx="13" stroke="#2A2C34" stroke-width="1.5" fill="#1A1C22" />
                  <circle cx="60" cy="185" r="4.5" stroke="#A4A8B3" stroke-width="1.25" />
                  <line x1="74" y1="185" x2="132" y2="185" stroke="#4B4F58" stroke-width="1.5" />
                  <!-- Grade 4x2 de Apps -->
                  <rect x="44" y="216" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="95" y="216" width="38" height="38" rx="8" stroke="#2B35AF" stroke-width="1.5" fill="#1D2247" />
                  <rect x="147" y="216" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="198" y="216" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="44" y="266" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="95" y="266" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="147" y="266" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <rect x="198" y="266" width="38" height="38" rx="8" stroke="#2A2C34" stroke-width="1.25" fill="#1A1C22" />
                  <!-- Dash fixo inferior -->
                  <rect x="52" y="322" width="176" height="30" rx="15" stroke="#2A2C34" stroke-width="1.5" fill="#1A1C22" />
                  <circle cx="82" cy="337" r="7" fill="#2A2C34" />
                  <circle cx="120" cy="337" r="7" fill="#2B35AF" />
                  <circle cx="158" cy="337" r="7" fill="#2A2C34" />
                  <circle cx="196" cy="337" r="7" fill="#2A2C34" />
                </svg>
              ) : project.variant === 'verso' ? (
                <svg
                  viewBox="0 0 280 380"
                  class="w-full max-w-[260px] h-auto text-[#F4F4F0]"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label="Diagrama esquemático da interface do Verso Music Player"
                >
                  <!-- Moldura do dispositivo -->
                  <rect x="20" y="10" width="240" height="360" rx="22" stroke="#2A2C34" stroke-width="1.5" fill="#131418" />
                  <!-- Capa do Álbum -->
                  <rect x="44" y="36" width="192" height="128" rx="6" stroke="#2A2C34" stroke-width="1.5" fill="#1A1C22" />
                  <circle cx="140" cy="100" r="34" stroke="#F4F4F0" stroke-width="1.25" />
                  <circle cx="140" cy="100" r="10" stroke="#2B35AF" stroke-width="1.5" />
                  <!-- Letras sincronizadas palavra por palavra -->
                  <rect x="44" y="186" width="84" height="8" rx="2" fill="#F4F4F0" />
                  <rect x="136" y="186" width="54" height="8" rx="2" fill="#2B35AF" />
                  <rect x="44" y="206" width="146" height="7" rx="2" fill="#4B4F58" />
                  <rect x="44" y="224" width="112" height="7" rx="2" fill="#2A2C34" />
                  <!-- Barra de progresso e waveform -->
                  <line x1="44" y1="268" x2="236" y2="268" stroke="#2A2C34" stroke-width="2" />
                  <line x1="44" y1="268" x2="148" y2="268" stroke="#F4F4F0" stroke-width="2" />
                  <circle cx="148" cy="268" r="4.5" fill="#2B35AF" />
                  <!-- Controles de reprodução -->
                  <path d="M96 312L80 322L96 332V312Z" stroke="#A4A8B3" stroke-width="1.5" stroke-linejoin="round" />
                  <circle cx="140" cy="322" r="20" fill="#F4F4F0" />
                  <path d="M135 314L149 322L135 330V314Z" fill="#131418" />
                  <path d="M184 312L200 322L184 332V312Z" stroke="#A4A8B3" stroke-width="1.5" stroke-linejoin="round" />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 280 380"
                  class="w-full max-w-[260px] h-auto text-[#F4F4F0]"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label="Diagrama esquemático de gravação em blocos de 4 MB do Flicker"
                >
                  <!-- Bloco ISO de origem -->
                  <rect x="40" y="24" width="200" height="76" rx="4" stroke="#2A2C34" stroke-width="1.5" fill="#131418" />
                  <rect x="56" y="42" width="44" height="14" rx="2" fill="#2B35AF" />
                  <line x1="112" y1="49" x2="220" y2="49" stroke="#F4F4F0" stroke-width="2" />
                  <line x1="56" y1="74" x2="178" y2="74" stroke="#4B4F58" stroke-width="1.5" />
                  <!-- Fluxo de blocos 4 MB -->
                  <line x1="140" y1="100" x2="140" y2="128" stroke="#2A2C34" stroke-width="1.5" />
                  <rect x="70" y="128" width="140" height="68" rx="4" stroke="#2A2C34" stroke-width="1.5" fill="#1A1C22" />
                  <rect x="86" y="146" width="24" height="16" fill="#F4F4F0" />
                  <rect x="116" y="146" width="24" height="16" fill="#2B35AF" />
                  <rect x="146" y="146" width="24" height="16" fill="#2A2C34" />
                  <rect x="176" y="146" width="18" height="16" fill="#2A2C34" />
                  <line x1="86" y1="176" x2="194" y2="176" stroke="#4B4F58" stroke-width="1.5" />
                  <line x1="140" y1="196" x2="140" y2="224" stroke="#2B35AF" stroke-width="1.5" />
                  <!-- Dispositivo USB /dev/sdX -->
                  <rect x="78" y="224" width="124" height="96" rx="6" stroke="#F4F4F0" stroke-width="1.5" fill="#131418" />
                  <rect x="108" y="320" width="64" height="32" stroke="#2A2C34" stroke-width="1.5" fill="#1A1C22" />
                  <rect x="120" y="330" width="14" height="12" fill="#2A2C34" />
                  <rect x="146" y="330" width="14" height="12" fill="#2A2C34" />
                  <!-- Verificação byte-a-byte -->
                  <circle cx="140" cy="272" r="22" stroke="#2B35AF" stroke-width="1.5" fill="#1D2247" />
                  <path d="M130 272L137 279L151 265" stroke="#F4F4F0" stroke-width="2" stroke-linecap="square" />
                </svg>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- Nível 2: Teoria e Web -->
      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[#D4D5CF] border-t border-[#D4D5CF]">
        {archiveProjects.map((project) => (
          <article class="p-6 sm:p-8 lg:p-10 flex flex-col justify-between bg-[#F4F4F0] hover:bg-[#ECECE6]/70 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-3 mb-5 font-mono text-[11px] uppercase tracking-wider">
                <span class="text-[#2B35AF] font-semibold">{project.language}</span>
                <span class="text-[#6C707A]">{project.category}</span>
              </div>

              <h3 class="font-display font-bold text-2xl tracking-[-0.02em] text-[#111214]">
                <a
                  href={project.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#2B35AF] transition-colors"
                >
                  {project.name}
                </a>
              </h3>

              <p class="mt-3 text-sm text-[#4B4F58] leading-relaxed">
                {project.description}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-[#D4D5CF] flex items-center justify-between">
              <a
                href={project.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-[#111214] hover:text-[#2B35AF] transition-colors inline-flex items-center gap-1.5"
              >
                <span>{project.actionLabel}</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path d="M4.5 11.5L11.5 4.5M6 4.5h5.5V10" stroke-linecap="square" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Rodapé da seção de projetos -->
      <div class="p-6 sm:px-10 lg:px-14 border-t border-[#D4D5CF] bg-[#ECECE6]/45 flex flex-wrap items-center justify-between gap-4">
        <span class="text-sm text-[#4B4F58]">
          Todos os repositórios públicos e experimentos estão disponíveis no GitHub.
        </span>
        <a
          href={`https://github.com/${githubUsername}?tab=repositories`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-[#111214] hover:text-[#2B35AF] transition-colors inline-flex items-center gap-2"
        >
          <span>Explorar todos os repositórios</span>
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="square" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

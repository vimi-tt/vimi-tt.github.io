---
// Header - Barra de navegação arquitetônica
---

<header class="sticky top-0 z-40 w-full bg-[#F4F4F0]/92 backdrop-blur-md border-b border-[#D4D5CF]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-20 gap-3">

      <a href="/#hero" class="flex items-center gap-2 sm:gap-3 group shrink-0">
        <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-[#2B35AF] shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true"></span>
        <span class="font-display font-black text-sm sm:text-xl tracking-[-0.03em] text-[#111214] uppercase whitespace-nowrap">
          Vitor Miranda
        </span>
      </a>

      <nav aria-label="Navegação principal" class="flex items-center gap-3 sm:gap-8 text-xs sm:text-sm font-medium text-[#4B4F58]">
        <a
          href="/#projetos"
          class="hover:text-[#111214] transition-colors py-1 whitespace-nowrap"
        >
          Projetos
        </a>
        <a
          href="/#habilidades"
          class="hover:text-[#111214] transition-colors py-1 whitespace-nowrap"
        >
          Stack
        </a>
        <a
          href="/blog"
          class="hover:text-[#111214] transition-colors py-1 whitespace-nowrap"
        >
          Blog
        </a>
        <a
          href="/#contato"
          class="hover:text-[#111214] transition-colors py-1 whitespace-nowrap"
        >
          Contato
        </a>
      </nav>

    </div>
  </div>
</header>

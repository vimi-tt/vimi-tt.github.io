---
// Navbar Component - High Contrast Neo-Brutalist Header
---

<header class="sticky top-0 z-40 w-full bg-[#0F0F0F]/90 backdrop-blur-md border-b border-white/20 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo / Nome à Esquerda na Cor de Destaque Lavanda -->
      <a href="/#hero" class="flex items-center gap-2 group" data-magnetic>
        <span class="font-display font-black text-xl sm:text-2xl tracking-tighter text-[#BDB2FF] group-hover:opacity-90 transition-opacity">
          VITOR MIRANDA
        </span>
      </a>

      <!-- Links de Navegação Pequenos e Monoespaçados -->
      <nav class="flex items-center gap-4 sm:gap-8 font-mono text-xs sm:text-sm tracking-wider">
        <a 
          href="/#projetos" 
          data-magnetic 
          class="text-[#F3F3F3]/80 hover:text-[#BDB2FF] transition-colors"
        >
          01/WORK
        </a>
        <a 
          href="/#habilidades" 
          data-magnetic 
          class="text-[#F3F3F3]/80 hover:text-[#BDB2FF] transition-colors"
        >
          02/STACK
        </a>
        <a 
          href="/blog" 
          data-magnetic 
          class="text-[#F3F3F3]/80 hover:text-[#BDB2FF] transition-colors"
        >
          03/BLOG
        </a>
        <a 
          href="/#contato" 
          data-magnetic 
          class="text-[#F3F3F3]/80 hover:text-[#BDB2FF] transition-colors"
        >
          04/CONTACT
        </a>
      </nav>

    </div>
  </div>
</header>

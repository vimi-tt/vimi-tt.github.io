---
import { getCollection } from 'astro:content';

let allPosts: any[] = [];
try {
  allPosts = await getCollection('blog', ({ data }) => !data.draft);
} catch (e) {
  allPosts = [];
}

if (!allPosts || allPosts.length === 0) {
  const globPosts = import.meta.glob('../content/blog/*.{md,mdx}', { eager: true });
  allPosts = Object.entries(globPosts)
    .map(([path, mod]: [string, any]) => {
      const slug = path.split('/').pop()?.replace(/\.(md|mdx)$/, '').toLowerCase();
      const frontmatter = mod.frontmatter || {};
      return {
        id: slug,
        slug: slug,
        data: {
          title: frontmatter.title || 'Sem Título',
          description: frontmatter.description || '',
          pubDate: frontmatter.pubDate ? new Date(frontmatter.pubDate) : new Date(),
          tags: frontmatter.tags || [],
          draft: frontmatter.draft || false
        }
      };
    })
    .filter((p) => !p.data.draft);
}

allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = allPosts.slice(0, 2);

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
    .toUpperCase();
---

{recentPosts.length > 0 && (
  <section id="blog" class="relative w-full border-b border-[#D4D5CF]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-x border-[#D4D5CF]">

        <div class="p-6 sm:p-10 lg:px-14 lg:py-12 border-b border-[#D4D5CF] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <h2 class="font-display font-black text-3xl sm:text-5xl text-[#111214] tracking-[-0.03em] uppercase">
            Notas Técnicas
          </h2>

          <a
            href="/blog"
            class="text-sm font-semibold text-[#111214] hover:text-[#2B35AF] transition-colors inline-flex items-center gap-2 self-start sm:self-auto"
          >
            <span>Ver todas as publicações</span>
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="square" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[#D4D5CF]">
          {recentPosts.map((post) => (
            <article class="p-6 sm:p-10 lg:p-14 flex flex-col justify-between bg-[#F4F4F0] hover:bg-[#ECECE6]/60 transition-colors group">
              <div>
                <div class="flex items-center justify-between gap-3 text-xs font-mono text-[#6C707A] mb-4">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <div class="flex flex-wrap gap-1.5">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="px-2 py-0.5 text-[11px] bg-[#ECECE6] border border-[#D4D5CF] text-[#4B4F58]">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <h3 class="font-display font-bold text-2xl text-[#111214] group-hover:text-[#2B35AF] transition-colors mb-3">
                  <a href={`/blog/${post.id || post.slug}`}>
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-sm sm:text-base text-[#4B4F58] leading-relaxed mb-6 line-clamp-3">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-[#D4D5CF]">
                <a
                  href={`/blog/${post.id || post.slug}`}
                  class="text-xs font-semibold text-[#111214] group-hover:text-[#2B35AF] transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Ler artigo completo</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M4.5 11.5L11.5 4.5M6 4.5h5.5V10" stroke-linecap="square" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
